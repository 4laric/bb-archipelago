<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <SoulsFormatsNextRoot Condition="'$(SoulsFormatsNextRoot)' == ''">$(SOULSFORMATS_NEXT)</SoulsFormatsNextRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../bb_event_writer/NativeEvents.cs" Link="NativeEvents.cs" />
    <EmbeddedResource Include="boss-event-pins.json" LogicalName="boss-event-pins.json" />
    <EmbeddedResource Include="boss-event-recipe.json" LogicalName="boss-event-recipe.json" />
    <ProjectReference Include="$(SoulsFormatsNextRoot)\SoulsFormats\SoulsFormats.csproj" />
  </ItemGroup>
</Project>
