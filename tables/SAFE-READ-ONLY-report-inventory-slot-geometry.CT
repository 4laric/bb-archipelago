<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only local diagnostic. Reports inventory capacities and vacant slots
     using the inventory pointer captured by the v3 grant harness. -->
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
local shadLog=[[C:\Users\alari\AppData\Roaming\shadPS4\log\shad_log.txt]]
local output=[[C:\Users\alari\bb-archipelago\work\bb-live-inventory-geometry.txt]]

local f=assert(io.open(shadLog,"r"))
local pending,base=false,nil
for line in f:lines() do
  if line:find("Loading module eboot.bin",1,true) then
    pending=true
  elseif pending then
    local hex=line:match("base_virtual_addr%s+%.+:%s+0x([0-9A-Fa-f]+)")
    if hex then base=tonumber(hex,16); pending=false end
  end
end
f:close()
if not base then error("Could not resolve the current eboot base") end

openProcess("shadPS4.exe")
local inventory=readQword(base+0x50DBE10)
if not inventory or inventory==0 then error("Grant harness has not captured the inventory pointer") end

local capacityA=readInteger(inventory+0x10)
local capacityB=readInteger(inventory+0x14)
local split=readInteger(inventory+0x24)
local last=readInteger(inventory+0x88)
local primary=readQword(inventory+0x58)
local secondary=readQword(inventory+0x48)
if not capacityA or not capacityB or not split or not last or not primary or not secondary then
  error("Could not read inventory geometry")
end

local out=assert(io.open(output,"w"))
out:write(string.format("eboot_base=0x%X\ninventory=0x%X\ncapacity_a=%d\ncapacity_b=%d\nsplit=%d\nlast=%d\nprimary=0x%X\nsecondary=0x%X\n",
  base,inventory,capacityA,capacityB,split,last,primary,secondary))

local vacantPrimary={}
for slot=0,split-1 do
  local entry=primary+slot*0x10
  local raw=readInteger(entry) or 0
  local normalized=readInteger(entry+4) or 0
  local quantity=readInteger(entry+8) or 0
  local flags=readInteger(entry+0xC) or 0
  if raw==0 then vacantPrimary[#vacantPrimary+1]=slot end
  out:write(string.format("primary[%d]=raw:0x%08X normalized:0x%08X quantity:%d flags:0x%08X\n",
    slot,raw,normalized,quantity,flags))
end

out:write("vacant_primary_count=",tostring(#vacantPrimary),"\n")
out:write("vacant_primary_slots=",table.concat(vacantPrimary,","),"\n")

local vacantSecondary={}
local occupiedSecondary={}
for slot=0,capacityB-1 do
  local entry=secondary+slot*0x10
  local raw=readInteger(entry) or 0
  if raw==0 then
    vacantSecondary[#vacantSecondary+1]=slot
  else
    occupiedSecondary[#occupiedSecondary+1]=slot
    if #occupiedSecondary<=128 then
      out:write(string.format("secondary[%d]=raw:0x%08X normalized:0x%08X quantity:%d flags:0x%08X\n",
        slot,raw,readInteger(entry+4) or 0,readInteger(entry+8) or 0,readInteger(entry+0xC) or 0))
    end
  end
end
out:write("vacant_secondary_count=",tostring(#vacantSecondary),"\n")
out:write("first_vacant_secondary_slots=",table.concat(vacantSecondary,",",1,math.min(#vacantSecondary,32)),"\n")
out:write("occupied_secondary_count=",tostring(#occupiedSecondary),"\n")
out:close()
showMessage(string.format("Read-only inventory report complete. Vacant banks: %d / %d",#vacantPrimary,#vacantSecondary))
]]></LuaScript>
</CheatTable>
