<?xml version="1.0" encoding="utf-8"?>
<!-- One-shot guarded diagnostic: disables the idle trigger and rearms the
     already-described Pebble grant for the next real consumable update. -->
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
local shadLog=[[C:\Users\alari\AppData\Roaming\shadPS4\log\shad_log.txt]]
local f=assert(io.open(shadLog,"r"))
local pending,base=false,nil
for line in f:lines() do
  if line:find("Loading module eboot.bin",1,true) then pending=true
  elseif pending then
    local hex=line:match("base_virtual_addr%s+%.+:%s+0x([0-9A-Fa-f]+)")
    if hex then base=tonumber(hex,16); pending=false end
  end
end
f:close()
if not base then error("Could not resolve eboot base") end
openProcess("shadPS4.exe")

local heartbeat=base+0x1BFE882
local heartbeatCave=base+0x50DBC00
local data=base+0x50DBE00
local jump=readBytes(heartbeat,7,true)
if not jump or jump[1]~=0xE9 then error("Heartbeat is not using the expected installed detour") end
local displacement=(jump[2] or 0)+(jump[3] or 0)*0x100+(jump[4] or 0)*0x10000+(jump[5] or 0)*0x1000000
if displacement>=0x80000000 then displacement=displacement-0x100000000 end
if heartbeat+5+displacement~=heartbeatCave then error("Heartbeat detour target differs; refusing write") end
if readInteger(data+0)~=0 or readInteger(data+4)~=1 or readInteger(data+8)~=0xFFFFFFFF or readInteger(data+0xC)~=1 then
  error("Grant state differs; refusing rearm")
end
if readInteger(data+0x20)~=0xB00004CE or readInteger(data+0x24)~=0x400004CE then
  error("Pebble descriptor differs; refusing rearm")
end

writeBytes(heartbeat,0x48,0x81,0xC4,0xE8,0x07,0x00,0x00)
local restored=readBytes(heartbeat,7,true)
local expected={0x48,0x81,0xC4,0xE8,0x07,0x00,0x00}
for i=1,7 do if not restored or restored[i]~=expected[i] then error("Heartbeat restore verification failed") end end
writeInteger(data+8,0xFFFFFFFF)
writeInteger(data+0xC,0)
writeInteger(data+0,1)
showMessage("Pebble grant rearmed for one real consumable update. Fire one bullet.")
]]></LuaScript>
</CheatTable>
