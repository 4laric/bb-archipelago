<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
local address=0x8050DB900
local size=0x100
local output=[[C:\Users\alari\bb-archipelago\work\heartbeat-cave-space.txt]]
openProcess("shadPS4.exe")
local bytes=readBytes(address,size,true)
if not bytes or #bytes~=size then error("Could not read heartbeat cave candidate") end
local lines={}
for offset=0,size-1,16 do
  local parts={}
  for i=1,16 do parts[#parts+1]=string.format("%02X",bytes[offset+i]) end
  lines[#lines+1]=string.format("0x%X  %s",address+offset,table.concat(parts," "))
end
local f=assert(io.open(output,"w")); f:write(table.concat(lines,"\n").."\n"); f:close()
showMessage("Read-only heartbeat cave-space capture completed")
]]></LuaScript>
</CheatTable>
