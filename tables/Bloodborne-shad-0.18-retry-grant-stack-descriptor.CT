<?xml version="1.0" encoding="utf-8"?>
<!-- One-shot guarded diagnostic. Rebuilds the native item descriptor on the
     game thread stack, avoiding the below-4-GiB eboot data cave. -->
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
local shadLog=[[C:\Users\alari\AppData\Roaming\shadPS4\log\shad_log.txt]]
local f=assert(io.open(shadLog,"r"))
local pending,base=false,nil
for line in f:lines() do
  if line:find("Loading module eboot.bin",1,true) then pending=true
  elseif pending then
    local hex=line:match("base_virtual_addr%s+%.+:%s+0x([0-9A-Fa-f]+)")
    if hex then base=tonumber(hex,16); pending=false end
  end
end
f:close()
if not base then error("Could not resolve eboot base") end
openProcess("shadPS4.exe")

local consume=base+0x14D9575
local cave=base+0x50DBA00
local heartbeat=base+0x1BFE882
local data=base+0x50DBE00
local jump=readBytes(consume,7,true)
if not jump or jump[1]~=0xE9 then error("Consume hook is not using the expected detour") end
local displacement=(jump[2] or 0)+(jump[3] or 0)*0x100+(jump[4] or 0)*0x10000+(jump[5] or 0)*0x1000000
if displacement>=0x80000000 then displacement=displacement-0x100000000 end
if consume+5+displacement~=cave then error("Consume detour target differs; refusing write") end
local hb=readBytes(heartbeat,7,true)
local hbExpected={0x48,0x81,0xC4,0xE8,0x07,0x00,0x00}
for i=1,7 do if not hb or hb[i]~=hbExpected[i] then error("Heartbeat is not restored; refusing write") end end
if readInteger(data+0)~=0 or readInteger(data+4)~=1 or readInteger(data+8)~=0xFFFFFFFF or readInteger(data+0xC)~=1 then
  error("Failed grant state differs; refusing retry")
end
if readInteger(data+0x20)~=0xB00004CE or readInteger(data+0x24)~=0x400004CE then
  error("Pebble descriptor differs; refusing retry")
end

local script=string.format([[
label(bbStackDescriptorOriginal)
label(bbStackDescriptorExisting)
label(bbStackDescriptorFinish)
%X:
  mov [%X],r13
  cmp dword ptr [%X],0
  je bbStackDescriptorOriginal
  cmp dword ptr [%X],2
  je bbStackDescriptorExisting
  mov dword ptr [%X],0
  sub rsp,20
  mov eax,[%X]
  mov [rsp],eax
  mov eax,[%X]
  mov [rsp+4],eax
  mov qword ptr [rsp+8],0
  mov rdi,r13
  mov rsi,rsp
  mov edx,[%X]
  mov rax,%X
  call rax
  add rsp,20
  jmp bbStackDescriptorFinish

bbStackDescriptorExisting:
  mov dword ptr [%X],0
  mov rdi,r13
  mov esi,[%X]
  mov edx,[%X]
  lea rcx,[%X]
  mov r8,[%X]
  xor r9d,r9d
  mov rax,%X
  call rax

bbStackDescriptorFinish:
  mov [%X],eax
  mov dword ptr [%X],1
bbStackDescriptorOriginal:
  mov eax,r12d
  add rsp,28
  jmp %X
]],
  cave,data+0x10,data,data,data,
  data+0x20,data+0x24,data+4,base+0x14DA0A0,
  data,data+0x34,data+4,data+0x30,data+0x38,base+0x14D94A0,
  data+8,data+0xC,base+0x14D957C)
local ok,why=autoAssemble(script)
if not ok then error("Stack-descriptor cave install failed: "..tostring(why)) end
writeInteger(data+8,0xFFFFFFFF)
writeInteger(data+0xC,0)
writeInteger(data,1)
showMessage("Stack-descriptor Pebble retry armed. Fire one bullet.")
]]></LuaScript>
</CheatTable>
