<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
local address = 0x208067BD8
local expected = 17
local replacement = 18

openProcess("shadPS4.exe")
local current = readInteger(address)
if current ~= expected then
    error(string.format(
        "Safety check failed: bullet candidate is %s, expected %d; nothing was written",
        tostring(current), expected))
end

writeInteger(address, replacement)
local verified = readInteger(address)
if verified ~= replacement then
    error(string.format("Write did not stick in memory: read back %s", tostring(verified)))
end

showMessage(string.format("Bullet test write succeeded: %d -> %d", current, verified))
]]></LuaScript>
</CheatTable>
