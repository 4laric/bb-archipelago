<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
local root=[[C:\Users\alari\bb-archipelago\work\]]
local commandPath=root..[[native-grant-command.txt]]
local statePath=root..[[native-grant-state.txt]]
local logPath=root..[[native-grant.log]]
local shadLog=[[C:\Users\alari\AppData\Roaming\shadPS4\log\shad_log.txt]]
local build=[[bb-0.1.0-r3]]
local protocol=[[BBGRANT1]]
local harness=[[bb-native-grant-v3]]
local maxVerifyPolls=20
local function readStateFile()
  local values={}
  local f=io.open(statePath,"r")
  if not f then return values end
  for line in f:lines() do
    local key,value=line:match("^([^=]+)=(.*)$")
    if key then values[key]=value end
  end
  f:close(); return values
end
local prior=readStateFile()
local stateTag=prior.tag or ""
local stateExpectedBefore=prior.expected_before or ""
local stateExpectedAfter=prior.expected_after or ""
local function readEbootBase()
  local f=io.open(shadLog,"r")
  if not f then return nil,"Could not open shad log" end
  local pending,found=false,nil
  for line in f:lines() do
    if line:find("Loading module eboot.bin",1,true) then pending=true
    elseif pending then
      local hex=line:match("base_virtual_addr%s+%.+:%s+0x([0-9A-Fa-f]+)")
      if hex then found=tonumber(hex,16); pending=false end
    end
  end
  f:close()
  if not found then return nil,"Could not find eboot base in shad log" end
  return found
end
local base,baseError=readEbootBase()
if not base then error(baseError) end
local consumeHook=base+0x14D9575
local heartbeatHook=base+0x1BFE882
local request=base+0x50DBE00
local quantity=request+4
local result=request+8
local done=request+0xC
local inventoryPointer=request+0x10
local descriptor=request+0x20
local slotIndex=request+0x34
local itemQuantityPointer=request+0x38
local active=nil
local pid=nil

local function append(message)
  local f=io.open(logPath,"a"); if f then f:write(os.date("!%Y-%m-%dT%H:%M:%SZ")," ",message,"\n"); f:close() end
end
local function state(status,detail)
  local f=assert(io.open(statePath,"w")); f:write(
    "build=",build,"\nprotocol=",protocol,"\nharness=",harness,"\nstatus=",status,
    "\npid=",tostring(pid or ""),"\ntag=",tostring(stateTag),
    "\nexpected_before=",tostring(stateExpectedBefore),
    "\nexpected_after=",tostring(stateExpectedAfter),
    "\ndetail=",tostring(detail or ""),"\n"); f:close()
end
local function parse(line)
  local t={}; for word in string.gmatch(line or "","%S+") do t[#t+1]=word end
  if t[1]~=protocol then return nil,"Unsupported grant protocol; expected "..protocol end
  if string.upper(t[2] or "")~="GRANT" then return nil,"Usage: "..protocol.." GRANT raw-id normalized-id quantity expected-before tag" end
  local raw,normalized,count,expected=tonumber(t[3] or ""),tonumber(t[4] or ""),tonumber(t[5] or ""),tonumber(t[6] or "")
  local autoExpected=string.upper(t[6] or "")=="AUTO"
  if not raw or not normalized or not count or (not expected and not autoExpected) or count<1 or count>99 or (expected and expected<0) then return nil,"Invalid IDs, quantity, or expected count" end
  return {line=line,raw=raw,normalized=normalized,count=count,expected=expected,autoExpected=autoExpected,tag=t[7] or "untagged",verifyPolls=0}
end
local function findItem(itemId)
  local inventory=readQword(inventoryPointer)
  if not inventory or inventory==0 then return nil end
  local split,last=readInteger(inventory+0x24),readInteger(inventory+0x88)
  local primary,secondary=readQword(inventory+0x58),readQword(inventory+0x48)
  if not split or not last or not primary or not secondary or last>=4096 then return nil end
  for slot=0,last do
    local entry=slot<split and (primary+slot*0x10) or (secondary+(slot-split)*0x10)
    if readInteger(entry+4)==itemId then return readInteger(entry+8) or 0,true,slot,entry+8 end
  end
  return 0,false
end

openProcess("shadPS4.exe")
pid=getOpenedProcessID()
if bbNativeGrantHarnessPid==pid and bbNativeGrantHarnessTimer then
  state("already_ready","Duplicate table execution ignored")
  return
end
local install=[[
assert(8014D9575,44 89 E0 48 83 C4 28)
assert(801BFE882,48 81 C4 E8 07 00 00)
assert(8050DBA00,00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00)
assert(8050DBC00,00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00)
assert(8050DBE00,00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00)
label(bbAutoConsumeOriginal)
label(bbAutoHeartbeatOriginal)
label(bbAutoExisting)
label(bbAutoFinish)
label(bbAutoRequest)
label(bbAutoQuantity)
label(bbAutoResult)
label(bbAutoDone)
label(bbAutoInventory)
label(bbAutoDescriptor)
label(bbAutoOverflow)
label(bbAutoSlotIndex)
label(bbAutoItemQuantityPointer)

8050DBA00:
  mov [bbAutoInventory],r13
  cmp dword ptr [bbAutoRequest],0
  je bbAutoConsumeOriginal
  cmp dword ptr [bbAutoRequest],2
  je bbAutoExisting
  mov dword ptr [bbAutoRequest],0
  sub rsp,20
  mov eax,[bbAutoDescriptor]
  mov [rsp],eax
  mov eax,[bbAutoDescriptor+4]
  mov [rsp+4],eax
  mov qword ptr [rsp+8],0
  mov rdi,r13
  mov rsi,rsp
  mov edx,[bbAutoQuantity]
  mov rax,8014DA0A0
  call rax
  add rsp,20
  jmp bbAutoFinish

bbAutoExisting:
  mov dword ptr [bbAutoRequest],0
  mov rdi,r13
  mov esi,[bbAutoSlotIndex]
  mov edx,[bbAutoQuantity]
  lea rcx,[bbAutoOverflow]
  mov r8,[bbAutoItemQuantityPointer]
  xor r9d,r9d
  mov rax,8014D94A0
  call rax

bbAutoFinish:
  mov [bbAutoResult],eax
  mov dword ptr [bbAutoDone],1
bbAutoConsumeOriginal:
  mov eax,r12d
  add rsp,28
  jmp 8014D957C

8050DBE00:
bbAutoRequest:
  dd 0
bbAutoQuantity:
  dd 0
bbAutoResult:
  dd 0
bbAutoDone:
  dd 0
bbAutoInventory:
  dq 0
bbAutoDescriptor:
  dd 0
  dd 0
  dd 0
  dd 0

bbAutoOverflow:
  dd 0
bbAutoSlotIndex:
  dd FFFFFFFF
bbAutoItemQuantityPointer:
  dq 0

8050DBE40:
  dd B0000384
  dd 40000384
  dd 0
  dd 0

8050DBC00:
  cmp dword ptr [bbAutoRequest],0
  je bbAutoHeartbeatOriginal
  cmp qword ptr [bbAutoInventory],0
  je bbAutoHeartbeatOriginal
  mov rdi,[bbAutoInventory]
  lea rsi,[8050DBE40]
  mov rax,8014DA2C0
  call rax
  cmp eax,-1
  je bbAutoHeartbeatOriginal
  mov rdi,[bbAutoInventory]
  mov esi,eax
  xor edx,edx
  lea rcx,[8050DBE4C]
  mov rax,8014D94A0
  call rax
bbAutoHeartbeatOriginal:
  add rsp,000007E8
  jmp 801BFE889

8014D9575:
  jmp 8050DBA00
  nop 2
801BFE882:
  jmp 8050DBC00
  nop 2
]]
local relocated={
  ["8014D9575"]=base+0x14D9575,
  ["8014D957C"]=base+0x14D957C,
  ["8014D94A0"]=base+0x14D94A0,
  ["8014DA0A0"]=base+0x14DA0A0,
  ["8014DA2C0"]=base+0x14DA2C0,
  ["801BFE882"]=base+0x1BFE882,
  ["801BFE889"]=base+0x1BFE889,
  ["8050DBA00"]=base+0x50DBA00,
  ["8050DBC00"]=base+0x50DBC00,
  ["8050DBE00"]=base+0x50DBE00,
  ["8050DBE40"]=base+0x50DBE40,
  ["8050DBE4C"]=base+0x50DBE4C,
}
for old,address in pairs(relocated) do
  install=install:gsub(old,string.format("%X",address))
end
local ok,detail=autoAssemble(install)
if not ok then state("setup_error",detail); error("Automatic grant harness install failed: "..tostring(detail)) end

local function poll()
  if active then
    if readInteger(done)==1 then
      local nativeResult=readInteger(result)
      local actual=findItem(active.normalized)
      local wanted=active.expected+active.count
      if actual~=wanted then
        active.verifyPolls=(active.verifyPolls or 0)+1
        if active.verifyPolls<maxVerifyPolls then
          state("verify_pending",string.format("tag=%s expected_after=%d actual=%s attempt=%d/%d",active.tag,wanted,tostring(actual),active.verifyPolls,maxVerifyPolls))
          return
        end
        append(string.format("AUTO FAILED tag=%s expected_after=%d actual=%s; retry budget exhausted",active.tag,wanted,tostring(actual)))
        state("failed",string.format("tag=%s expected_after=%d actual=%s retry_budget=%d",active.tag,wanted,tostring(actual),maxVerifyPolls))
        os.remove(commandPath)
        active=nil
        return
      end
      append(string.format("AUTO COMPLETED tag=%s raw=0x%08X normalized=0x%08X quantity=%d native_result=%s",
        active.tag,active.raw,active.normalized,active.count,tostring(nativeResult)))
      state("completed",string.format("tag=%s native_result=%s",active.tag,tostring(nativeResult)))
      os.remove(commandPath)
      active=nil
    end
    return
  end
  local f=io.open(commandPath,"r")
  if not f then
    if readQword(inventoryPointer)==0 then state("awaiting_inventory","Use one bullet once after launch") end
    return
  end
  local line=f:read("*l") or ""; f:close()
  local command,why=parse(line)
  if not command then state("command_rejected",why); os.remove(commandPath); return end
  if readQword(inventoryPointer)==0 then state("awaiting_inventory","Command retained; use one bullet once") return end
  local actual,exists,slot,quantityPointer=findItem(command.normalized)
  if command.autoExpected then
    local priorBefore,priorAfter=tonumber(prior.expected_before or ""),tonumber(prior.expected_after or "")
    local recoverable=prior.build==build and prior.protocol==protocol and prior.harness==harness and prior.tag==command.tag
      and priorBefore~=nil and priorAfter==priorBefore+command.count
      and (prior.status=="executing" or prior.status=="queued" or prior.status=="verify_pending"
        or prior.status=="recovery_pending" or prior.status=="completed" or prior.status=="recovered_complete")
    if recoverable then
      command.expected=priorBefore
    else
      command.expected=actual
    end
  end
  local wanted=command.expected+command.count
  stateTag=command.tag
  stateExpectedBefore=command.expected
  stateExpectedAfter=wanted
  if actual==wanted then
    append(string.format("AUTO RECOVERED tag=%s quantity=%d; command already applied",command.tag,actual))
    state("recovered_complete",string.format("tag=%s quantity=%d",command.tag,actual))
    os.remove(commandPath)
    return
  end
  if actual~=command.expected then
    state("quantity_mismatch",string.format("tag=%s expected_before=%d actual=%s",command.tag,command.expected,tostring(actual)))
    os.remove(commandPath)
    return
  end
  if exists then
    if not quantityPointer or quantityPointer==0 then
      state("write_error",string.format("tag=%s quantity pointer missing",command.tag))
      os.remove(commandPath)
      return
    end
    local before=readInteger(quantityPointer)
    if before~=command.expected then
      state("write_error",string.format("tag=%s pointer quantity changed expected=%d actual=%s",command.tag,command.expected,tostring(before)))
      os.remove(commandPath)
      return
    end
    state("executing",string.format("tag=%s direct expected_before=%d expected_after=%d",command.tag,command.expected,wanted))
    if not writeInteger(quantityPointer,wanted) then
      state("write_error",string.format("tag=%s quantity write failed",command.tag))
      os.remove(commandPath)
      return
    end
    local after=readInteger(quantityPointer)
    if after~=wanted then
      state("failed",string.format("tag=%s direct expected_after=%d actual=%s",command.tag,wanted,tostring(after)))
      os.remove(commandPath)
      return
    end
    append(string.format("DIRECT COMPLETED tag=%s normalized=0x%08X before=%d after=%d address=0x%X",
      command.tag,command.normalized,before,after,quantityPointer))
    state("completed",string.format("tag=%s direct before=%d after=%d",command.tag,before,after))
    os.remove(commandPath)
    return
  end
  if readInteger(request)~=0 then state("busy","Native request already pending") return end
  writeInteger(descriptor+0,command.raw); writeInteger(descriptor+4,command.normalized)
  writeInteger(descriptor+8,0); writeInteger(descriptor+12,0)
  writeInteger(slotIndex,slot or 0xFFFFFFFF)
  writeQword(itemQuantityPointer,quantityPointer or 0)
  writeInteger(quantity,command.count); writeInteger(result,0xFFFFFFFF); writeInteger(done,0)
  state("executing",string.format("tag=%s expected_before=%d expected_after=%d",command.tag,command.expected,wanted))
  writeInteger(request,1); active=command
  append(string.format("AUTO QUEUED tag=%s raw=0x%08X normalized=0x%08X quantity=%d expected_before=%d",command.tag,command.raw,command.normalized,command.count,command.expected))
  state("queued",string.format("tag=%s heartbeat will execute automatically",command.tag))
end

if bbNativeGrantHarnessTimer then bbNativeGrantHarnessTimer.destroy() end
bbNativeGrantHarnessTimer=createTimer(nil); bbNativeGrantHarnessTimer.Interval=250
bbNativeGrantHarnessTimer.OnTimer=poll; bbNativeGrantHarnessTimer.Enabled=true
bbNativeGrantHarnessPid=pid
local pendingCommand=io.open(commandPath,"r")
if pendingCommand then pendingCommand:close() end
if pendingCommand and prior.build==build and prior.protocol==protocol and prior.harness==harness and prior.tag~="" then
  state("recovery_pending","Retained command and durable expected counts will be reconciled")
else
  stateTag=""; stateExpectedBefore=""; stateExpectedAfter=""
  state("awaiting_inventory","Use one bullet once after launch")
end
append(string.format("AUTO V3 READY build=%s protocol=%s harness=%s pid=%d ebootBase=0x%X consumeHook=0x%X heartbeatHook=0x%X",build,protocol,harness,pid,base,consumeHook,heartbeatHook))
]]></LuaScript>
</CheatTable>
