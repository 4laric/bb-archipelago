<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
-- Compatibility shim: getProcessIDFromName is absent from some Cheat Engine
-- builds (observed failing on a playtester's install, 2026-08-23). Provide it
-- from getProcessList, which every supported CE version has, so the auto-run
-- path cannot nil-call and re-raise the Lua Engine window on every load.
if getProcessIDFromName==nil then
  getProcessIDFromName=function(processName)
    local wanted=processName:lower()
    local list=getProcessList()
    if type(list)~="table" then return nil end
    for pid,name in pairs(list) do
      if type(name)=="string" and name:lower()==wanted then return pid end
    end
    return nil
  end
end
local function startBloodborneHarness()
local roamingAppData=os.getenv("APPDATA")
if not roamingAppData or roamingAppData=="" then
  showMessage("Bloodborne AP table setup failed: APPDATA is not set")
  return
end
-- The bridge directory is the contract with the AP client, which reads
-- %LOCALAPPDATA%\BloodborneArchipelago\bridge\native-grant-state.txt.
-- Writing to CE's temp folder instead (the previous behavior) meant a
-- launcher-launched client never saw the harness state and every grant was
-- blocked; writing here also works when CE is started manually. The temp
-- folder remains a last-resort fallback, with a loud warning, if the bridge
-- directory cannot be created. CE exposes no directory-creation Lua
-- function; lfs (LuaFileSystem) ships with CE and is global (see CE's own
-- autorun/andtools.lua), and lfs.mkdir creates one level per call.
local localAppData=os.getenv("LOCALAPPDATA")
local root
if localAppData and localAppData~="" and lfs and lfs.mkdir then
  local base=localAppData..[[\BloodborneArchipelago]]
  local bridge=base..[[\bridge]]
  local okBase=pcall(lfs.mkdir, base)
  local okBridge=pcall(lfs.mkdir, bridge)
  -- lfs.mkdir returns nil when the directory already exists, so success is
  -- "the bridge directory is usable", which the first state write proves;
  -- here we only require that the mkdir calls themselves did not raise.
  if okBase and okBridge then root=bridge end
end
if not root then
  root=getTempFolder()
  if not root or root=="" then error("Cheat Engine did not provide a temporary directory") end
  showMessage("Bloodborne AP table: could not create %LOCALAPPDATA%\\BloodborneArchipelago\\bridge, so bridge files are going to the TEMP folder and the AP client WILL NOT receive item grants. Create that folder manually and reopen the table.")
end
print("Bloodborne AP bridge directory: "..root)
if root:sub(-1)~=[[\]] then root=root..[[\]] end
local commandPath=root..[[native-grant-command.txt]]
local statePath=root..[[native-grant-state.txt]]
local logPath=root..[[native-grant.log]]
local shadLog=roamingAppData..[[\shadPS4\log\shad_log.txt]]
local build=[[bb-0.1.0-r5]]
local protocol=[[BBGRANT1]]
local harness=[[bb-native-grant-v5]]
local maxVerifyPolls=20
local maxManualWaitPolls=1200
local bootstrapVialPending=true
local bootstrapAbsentPolls=0
local minBootstrapAbsentPolls=40
local grantAbsentTag=""
local grantAbsentPolls=0
local minGrantAbsentPolls=40
local bootstrapVialNormalized=0x400003E8
local bootstrapVialHeldCap=20
local bootstrapBulletNormalized=0x40000384
local function readStateFile()
  local values={}
  local f=io.open(statePath,"r")
  if not f then return values end
  for line in f:lines() do
    local key,value=line:match("^([^=]+)=(.*)$")
    if key then values[key]=value end
  end
  f:close(); return values
end
local prior=readStateFile()
local stateTag=prior.tag or ""
local stateExpectedBefore=prior.expected_before or ""
local stateExpectedAfter=prior.expected_after or ""
local consumeRva=0x14D9575
local heartbeatRva=0x1BFE882
local consumeOriginal={0x44,0x89,0xE0,0x48,0x83,0xC4,0x28}
local heartbeatOriginal={0x48,0x81,0xC4,0xE8,0x07,0x00,0x00}
local function matchBytes(address,expected)
  local actual=readBytes(address,#expected,true)
  if not actual then return false end
  for i=1,#expected do if actual[i]~=expected[i] then return false end end
  return true
end
local function scanEbootBase()
  local matches=AOBScan("44 89 E0 48 83 C4 28 5B 41 5C 41 5D 41 5E 41 5F")
  if not matches then return nil,"live signature scan found no consume-return candidates" end
  local candidates={}
  for i=0,matches.Count-1 do
    local consume=tonumber(matches[i],16)
    local candidate=consume-consumeRva
    if matchBytes(candidate+heartbeatRva,heartbeatOriginal) then
      candidates[#candidates+1]=candidate
    end
  end
  matches.destroy()
  if #candidates~=1 then
    return nil,string.format("live signature scan found %d validated eboot candidates",#candidates)
  end
  return candidates[1]
end
local function readEbootBase()
  local f=io.open(shadLog,"r")
  local pending,found=false,nil
  if f then
    for line in f:lines() do
      if line:find("Loading module eboot.bin",1,true) then pending=true
      elseif pending then
        local hex=line:match("base_virtual_addr%s+%.+:%s+0x([0-9A-Fa-f]+)")
        if hex then found=tonumber(hex,16); pending=false end
      end
    end
    f:close()
  end
  if found and matchBytes(found+consumeRva,consumeOriginal)
      and matchBytes(found+heartbeatRva,heartbeatOriginal) then return found end
  local scanned,scanError=scanEbootBase()
  if scanned then return scanned end
  local logged=found and string.format("0x%X",found) or "missing"
  return nil,"Logged eboot base "..logged.." was stale or invalid; "..scanError..".\nLog checked: "..shadLog
end
local attachedPid=getOpenedProcessID()
if not attachedPid or attachedPid==0 then
  error("Attach Cheat Engine to the Bloodborne shadPS4.exe process before loading this table")
end
local base,baseError=readEbootBase()
if not base then
  error(baseError)
end
local consumeHook=base+consumeRva
local heartbeatHook=base+heartbeatRva
local request=base+0x50DBE00
local quantity=request+4
local result=request+8
local done=request+0xC
local inventoryPointer=request+0x10
local descriptor=request+0x60
local slotIndex=request+0x34
local itemQuantityPointer=request+0x38
local manualTrigger=request+0x50
local active=nil
local pid=attachedPid

local function append(message)
  local f=io.open(logPath,"a"); if f then f:write(os.date("!%Y-%m-%dT%H:%M:%SZ")," ",message,"\n"); f:close() end
end
local function state(status,detail)
  local f=assert(io.open(statePath,"w")); f:write(
    "build=",build,"\nprotocol=",protocol,"\nharness=",harness,"\nstatus=",status,
    "\npid=",tostring(pid or ""),"\ntag=",tostring(stateTag),
    "\nexpected_before=",tostring(stateExpectedBefore),
    "\nexpected_after=",tostring(stateExpectedAfter),
    "\ndetail=",tostring(detail or ""),"\n"); f:close()
end
local function parse(line)
  local t={}; for word in string.gmatch(line or "","%S+") do t[#t+1]=word end
  if t[1]~=protocol then return nil,"Unsupported grant protocol; expected "..protocol end
  if string.upper(t[2] or "")~="GRANT" then return nil,"Usage: "..protocol.." GRANT raw-id normalized-id quantity expected-before tag [AUTO|MANUAL]" end
  local raw,normalized,count,expected=tonumber(t[3] or ""),tonumber(t[4] or ""),tonumber(t[5] or ""),tonumber(t[6] or "")
  local autoExpected=string.upper(t[6] or "")=="AUTO"
  local trigger=string.upper(t[8] or "AUTO")
  if not raw or not normalized or not count or (not expected and not autoExpected) or count<1 or count>99 or (expected and expected<0) or (trigger~="AUTO" and trigger~="MANUAL") then return nil,"Invalid IDs, quantity, expected count, or trigger mode" end
  return {line=line,raw=raw,normalized=normalized,count=count,expected=expected,autoExpected=autoExpected,tag=t[7] or "untagged",manualTrigger=trigger=="MANUAL",verifyPolls=0,waitPolls=0}
end
local function findItem(itemId)
  local inventory=readQword(inventoryPointer)
  if not inventory or inventory==0 then return nil end
  local split,last=readInteger(inventory+0x24),readInteger(inventory+0x88)
  local primary,secondary=readQword(inventory+0x58),readQword(inventory+0x48)
  if not split or not last or not primary or not secondary or last>=4096 then return nil end
  for slot=0,last do
    local entry=slot<split and (primary+slot*0x10) or (secondary+(slot-split)*0x10)
    if readInteger(entry+4)==itemId then return readInteger(entry+8) or 0,true,slot,entry+8 end
  end
  return 0,false
end

local function findUniqueItemByLowId(lowId)
  local inventory=readQword(inventoryPointer)
  if not inventory or inventory==0 then return nil end
  local split,last=readInteger(inventory+0x24),readInteger(inventory+0x88)
  local primary,secondary=readQword(inventory+0x58),readQword(inventory+0x48)
  if not split or not last or not primary or not secondary or last>=4096 then return nil end
  local match=nil
  for slot=0,last do
    local entry=slot<split and (primary+slot*0x10) or (secondary+(slot-split)*0x10)
    local runtimeId=readInteger(entry+4)
    if runtimeId and runtimeId%0x10000000==lowId then
      if match then return nil,nil,nil,nil,"ambiguous" end
      match={quantity=readInteger(entry+8) or 0,slot=slot,pointer=entry+8,runtimeId=runtimeId}
    end
  end
  if not match then return 0,false end
  return match.quantity,true,match.slot,match.pointer,match.runtimeId
end

local function readSlotRecord(slot)
  local inventory=readQword(inventoryPointer)
  if not inventory or inventory==0 or not slot or slot<0 then return nil end
  local split,last=readInteger(inventory+0x24),readInteger(inventory+0x88)
  local primary,secondary=readQword(inventory+0x58),readQword(inventory+0x48)
  if not split or not last or not primary or not secondary or last>=4096 or slot>last then return nil end
  local entry=slot<split and (primary+slot*0x10) or (secondary+(slot-split)*0x10)
  return readInteger(entry+4),readInteger(entry+8),entry
end

if bbNativeGrantHarnessPid==pid and bbNativeGrantHarnessTimer then
  state("already_ready","Duplicate table execution ignored")
  showMessage("Bloodborne AP table is already installed for this process.\nFire one Bullet only if bootstrap has not already completed.")
  return
end
local install=[[
assert(8014D9575,44 89 E0 48 83 C4 28)
assert(801BFE882,48 81 C4 E8 07 00 00)
assert(8050DBA00,00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00)
assert(8050DBC00,00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00)
assert(8050DBE00,00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00)
assert(8050DBE60,00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00)
label(bbAutoConsumeOriginal)
label(bbAutoHeartbeatOriginal)
label(bbAutoExisting)
label(bbAutoFinish)
label(bbAutoDescriptorReady)
label(bbAutoRequest)
label(bbAutoQuantity)
label(bbAutoResult)
label(bbAutoDone)
label(bbAutoInventory)
label(bbAutoDescriptor)
label(bbAutoOverflow)
label(bbAutoSlotIndex)
label(bbAutoItemQuantityPointer)
label(bbAutoManualTrigger)

8050DBA00:
  mov [bbAutoInventory],r13
  cmp dword ptr [bbAutoRequest],0
  je bbAutoConsumeOriginal
  cmp dword ptr [bbAutoRequest],2
  je bbAutoExisting
  mov dword ptr [bbAutoRequest],0
  mov eax,[bbAutoDescriptor]
  mov [rsp],eax
  mov qword ptr [rsp+8],0
  mov eax,[bbAutoDescriptor+10]
  mov [rsp+10],eax
  mov dword ptr [rsp+14],0
  mov rdi,r13
  mov rsi,rsp
  mov eax,[bbAutoDescriptor]
  and eax,F0000000
  cmp eax,80000000
  jne bbAutoDescriptorReady
  lea rsi,[bbAutoDescriptor]
bbAutoDescriptorReady:
  mov edx,[bbAutoQuantity]
  mov rax,8014DA0A0
  call rax
  jmp bbAutoFinish

bbAutoExisting:
  mov dword ptr [bbAutoRequest],0
  mov rdi,r13
  mov esi,[bbAutoSlotIndex]
  mov edx,[bbAutoQuantity]
  lea rcx,[bbAutoOverflow]
  mov r8,[bbAutoItemQuantityPointer]
  xor r9d,r9d
  mov rax,8014D94A0
  call rax

bbAutoFinish:
  mov [bbAutoResult],eax
  mov dword ptr [bbAutoDone],1
bbAutoConsumeOriginal:
  mov eax,r12d
  add rsp,28
  jmp 8014D957C

8050DBE00:
bbAutoRequest:
  dd 0
bbAutoQuantity:
  dd 0
bbAutoResult:
  dd 0
bbAutoDone:
  dd 0
bbAutoInventory:
  dq 0

8050DBE30:
bbAutoOverflow:
  dd 0
bbAutoSlotIndex:
  dd FFFFFFFF
bbAutoItemQuantityPointer:
  dq 0

8050DBE40:
  dd B0000384
  dd 40000384
  dd 0

8050DBE50:
bbAutoManualTrigger:
  dd 0
  dd 0

8050DBE60:
bbAutoDescriptor:
  dd 0
  dd 0
  dq 0
  dd 0
  dd 0

8050DBC00:
  cmp dword ptr [bbAutoManualTrigger],0
  jne bbAutoHeartbeatOriginal
  cmp dword ptr [bbAutoRequest],0
  je bbAutoHeartbeatOriginal
  cmp qword ptr [bbAutoInventory],0
  je bbAutoHeartbeatOriginal
  mov rdi,[bbAutoInventory]
  lea rsi,[8050DBE40]
  mov rax,8014DA2C0
  call rax
  cmp eax,-1
  je bbAutoHeartbeatOriginal
  mov rdi,[bbAutoInventory]
  mov esi,eax
  xor edx,edx
  lea rcx,[8050DBE4C]
  mov rax,8014D94A0
  call rax
bbAutoHeartbeatOriginal:
  add rsp,000007E8
  jmp 801BFE889

8014D9575:
  jmp 8050DBA00
  nop 2
801BFE882:
  jmp 8050DBC00
  nop 2
]]
local relocated={
  ["8014D9575"]=base+0x14D9575,
  ["8014D957C"]=base+0x14D957C,
  ["8014D94A0"]=base+0x14D94A0,
  ["8014DA0A0"]=base+0x14DA0A0,
  ["8014DA2C0"]=base+0x14DA2C0,
  ["801BFE882"]=base+0x1BFE882,
  ["801BFE889"]=base+0x1BFE889,
  ["8050DBA00"]=base+0x50DBA00,
  ["8050DBC00"]=base+0x50DBC00,
  ["8050DBE00"]=base+0x50DBE00,
  ["8050DBE30"]=base+0x50DBE30,
  ["8050DBE40"]=base+0x50DBE40,
  ["8050DBE4C"]=base+0x50DBE4C,
  ["8050DBE50"]=base+0x50DBE50,
  ["8050DBE60"]=base+0x50DBE60,
}
for old,address in pairs(relocated) do
  install=install:gsub(old,string.format("%X",address))
end
local ok,detail=autoAssemble(install)
if not ok then state("setup_error",detail); error("Automatic grant harness install failed: "..tostring(detail)) end

local function finishBootstrap(status,detail)
  bootstrapVialPending=false
  stateTag="bootstrap_vial"
  state(status,detail)
  local outcome=status=="bootstrap_complete" and "SUCCESS"
    or status=="bootstrap_skipped" and "SKIPPED"
    or "FAILED"
  showMessage("Bloodborne AP bootstrap "..outcome..":\n"..tostring(detail or ""))
end

local function tryBootstrapVial()
  if not bootstrapVialPending then return false end
  if readQword(inventoryPointer)==0 then return false end
  local actual,exists,slot,quantityPointer=findItem(bootstrapVialNormalized)
  if actual==nil then return false end
  if not exists and bootstrapAbsentPolls<minBootstrapAbsentPolls then
    bootstrapAbsentPolls=bootstrapAbsentPolls+1
    stateTag="bootstrap_vial"
    state("bootstrap_waiting",string.format("Waiting for inventory hydration before declaring the Vial stack absent (%d/%d)",bootstrapAbsentPolls,minBootstrapAbsentPolls))
    return false
  end
  if actual>=bootstrapVialHeldCap then
    append(string.format("BOOTSTRAP VIAL SKIPPED held=%d cap=%d",actual,bootstrapVialHeldCap))
    finishBootstrap("bootstrap_skipped",string.format("Blood Vials already at held cap (%d)",actual))
    return true
  end
  stateTag="bootstrap_vial"
  stateExpectedBefore=actual
  stateExpectedAfter=actual+1
  if exists then
    if not quantityPointer or quantityPointer==0 then
      finishBootstrap("bootstrap_failed","Existing Blood Vial quantity pointer is missing")
      return true
    end
    local before=readInteger(quantityPointer)
    if before~=actual or not writeInteger(quantityPointer,before+1) then
      finishBootstrap("bootstrap_failed",string.format("Could not increment Blood Vials from %s",tostring(before)))
      return true
    end
    local after=readInteger(quantityPointer)
    if after~=before+1 then
      finishBootstrap("bootstrap_failed",string.format("Blood Vial verification expected=%d actual=%s",before+1,tostring(after)))
      return true
    end
    append(string.format("BOOTSTRAP VIAL COMPLETED direct before=%d after=%d",before,after))
    finishBootstrap("bootstrap_complete",string.format("Blood Vials %d -> %d; harness is ready",before,after))
    return true
  end
  local bulletActual,bulletExists,_,bulletQuantityPointer=findItem(bootstrapBulletNormalized)
  local bulletRuntimeId=bootstrapBulletNormalized
  if not bulletExists then
    bulletActual,bulletExists,_,bulletQuantityPointer,bulletRuntimeId=findUniqueItemByLowId(0x384)
  end
  if not bulletExists or not bulletQuantityPointer or bulletQuantityPointer==0 then
    finishBootstrap("bootstrap_skipped","No Blood Vial stack exists and the spent bootstrap Bullet could not be refunded; no item was created")
    return true
  end
  local bulletBefore=readInteger(bulletQuantityPointer)
  if bulletBefore~=bulletActual or not writeInteger(bulletQuantityPointer,bulletBefore+1) then
    finishBootstrap("bootstrap_failed",string.format("Could not refund bootstrap Bullet from %s",tostring(bulletBefore)))
    return true
  end
  local bulletAfter=readInteger(bulletQuantityPointer)
  if bulletAfter~=bulletBefore+1 then
    finishBootstrap("bootstrap_failed",string.format("Bullet refund verification expected=%d actual=%s",bulletBefore+1,tostring(bulletAfter)))
    return true
  end
  stateExpectedBefore=bulletBefore
  stateExpectedAfter=bulletAfter
  append(string.format("BOOTSTRAP BULLET REFUNDED runtime_id=0x%08X before=%d after=%d; absent Vial insertion intentionally skipped",bulletRuntimeId,bulletBefore,bulletAfter))
  finishBootstrap("bootstrap_complete",string.format("No Blood Vial stack existed; bootstrap Bullet 0x%08X refunded %d -> %d; harness is ready",bulletRuntimeId,bulletBefore,bulletAfter))
  return true
end

local function poll()
  if active then
    if readInteger(done)==1 then
      local nativeResult=readInteger(result)
      local actual=findItem(active.normalized)
      local wanted=active.expected+active.count
      -- Verify against the slot the native insert reported, not only the
      -- whole-inventory scan: findItem returns the FIRST matching stack, which
      -- is the wrong evidence when the game merged into a stack that was not
      -- visible at queue time or a second stack exists (observed live:
      -- expected_after=2 actual=10 while the insert had landed at slot 82).
      local slotId,slotQuantity,slotAddress=readSlotRecord(nativeResult)
      local slotVerified=slotId==active.normalized and slotQuantity~=nil and slotQuantity>=active.count
      if not slotVerified and actual~=wanted then
        active.verifyPolls=(active.verifyPolls or 0)+1
        if active.verifyPolls<maxVerifyPolls then
          state("verify_pending",string.format("tag=%s expected_after=%d actual=%s attempt=%d/%d",active.tag,wanted,tostring(actual),active.verifyPolls,maxVerifyPolls))
          return
        end
        local slotDetail=slotId and string.format(" slot=%d slot_id=0x%08X slot_quantity=%s slot_address=0x%X",
          nativeResult,slotId,tostring(slotQuantity),slotAddress) or " result_slot_unreadable"
        append(string.format("AUTO FAILED tag=%s expected_after=%d actual=%s native_result=%s%s; retry budget exhausted",active.tag,wanted,tostring(actual),tostring(nativeResult),slotDetail))
        if active.bootstrap then
          local failureDetail=string.format("expected_after=%d actual=%s native_result=%s retry_budget=%d%s",
            wanted,tostring(actual),tostring(nativeResult),maxVerifyPolls,slotDetail)
          active=nil
          finishBootstrap("bootstrap_failed",failureDetail)
        else
          state("failed",string.format("tag=%s expected_after=%d actual=%s native_result=%s retry_budget=%d%s",active.tag,wanted,tostring(actual),tostring(nativeResult),maxVerifyPolls,slotDetail))
          os.remove(commandPath)
          active=nil
        end
        return
      end
      append(string.format("AUTO COMPLETED tag=%s raw=0x%08X normalized=0x%08X quantity=%d native_result=%s slot_quantity=%s",
        active.tag,active.raw,active.normalized,active.count,tostring(nativeResult),tostring(slotQuantity)))
      if active.bootstrap then
        local before=active.expected
        active=nil
        finishBootstrap("bootstrap_complete",string.format("Blood Vials %d -> %d; native_result=%s; harness is ready",before,wanted,tostring(nativeResult)))
      else
        state("completed",string.format("tag=%s native_result=%s",active.tag,tostring(nativeResult)))
        os.remove(commandPath)
        active=nil
      end
    elseif active.manualTrigger then
      active.waitPolls=(active.waitPolls or 0)+1
      if active.waitPolls>=maxManualWaitPolls then
        writeInteger(request,0)
        state("failed",string.format("tag=%s manual trigger timed out after %d polls",active.tag,maxManualWaitPolls))
        os.remove(commandPath)
        active=nil
      end
    end
    return
  end
  if tryBootstrapVial() then return end
  local f=io.open(commandPath,"r")
  if not f then
    if readQword(inventoryPointer)==0 then state("awaiting_inventory","Use one bullet once after launch") end
    return
  end
  local line=f:read("*l") or ""; f:close()
  local command,why=parse(line)
  if not command then state("command_rejected",why); os.remove(commandPath); return end
  if readQword(inventoryPointer)==0 then state("awaiting_inventory","Command retained; use one bullet once") return end
  local actual,exists,slot,quantityPointer=findItem(command.normalized)
  if actual==nil then
    state("awaiting_inventory","Command retained; inventory geometry is not hydrated yet")
    return
  end
  if not exists then
    -- Inventory hydration is incremental after a save load (the bootstrap waits
    -- it out for Vials); a grant that declares a stack absent too early native-
    -- inserts a duplicate stack next to one the scan could not see yet.
    if grantAbsentTag~=command.tag then grantAbsentTag=command.tag; grantAbsentPolls=0 end
    grantAbsentPolls=grantAbsentPolls+1
    if grantAbsentPolls<minGrantAbsentPolls then
      state("awaiting_inventory",string.format("tag=%s waiting for inventory hydration before declaring the stack absent (%d/%d)",command.tag,grantAbsentPolls,minGrantAbsentPolls))
      return
    end
  else
    grantAbsentTag=""; grantAbsentPolls=0
  end
  if command.autoExpected then
    local priorBefore,priorAfter=tonumber(prior.expected_before or ""),tonumber(prior.expected_after or "")
    local recoverable=prior.build==build and prior.protocol==protocol and prior.harness==harness and prior.tag==command.tag
      and priorBefore~=nil and priorAfter==priorBefore+command.count
      and (prior.status=="executing" or prior.status=="queued" or prior.status=="verify_pending"
        or prior.status=="recovery_pending" or prior.status=="completed" or prior.status=="recovered_complete")
    if recoverable then
      command.expected=priorBefore
    else
      command.expected=actual
    end
  end
  local wanted=command.expected+command.count
  stateTag=command.tag
  stateExpectedBefore=command.expected
  stateExpectedAfter=wanted
  if actual==wanted then
    append(string.format("AUTO RECOVERED tag=%s quantity=%d; command already applied",command.tag,actual))
    state("recovered_complete",string.format("tag=%s quantity=%d",command.tag,actual))
    os.remove(commandPath)
    return
  end
  if actual~=command.expected then
    state("quantity_mismatch",string.format("tag=%s expected_before=%d actual=%s",command.tag,command.expected,tostring(actual)))
    os.remove(commandPath)
    return
  end
  if exists then
    if not quantityPointer or quantityPointer==0 then
      state("write_error",string.format("tag=%s quantity pointer missing",command.tag))
      os.remove(commandPath)
      return
    end
    local before=readInteger(quantityPointer)
    if before~=command.expected then
      state("write_error",string.format("tag=%s pointer quantity changed expected=%d actual=%s",command.tag,command.expected,tostring(before)))
      os.remove(commandPath)
      return
    end
    state("executing",string.format("tag=%s direct expected_before=%d expected_after=%d",command.tag,command.expected,wanted))
    if not writeInteger(quantityPointer,wanted) then
      state("write_error",string.format("tag=%s quantity write failed",command.tag))
      os.remove(commandPath)
      return
    end
    local after=readInteger(quantityPointer)
    if after~=wanted then
      state("failed",string.format("tag=%s direct expected_after=%d actual=%s",command.tag,wanted,tostring(after)))
      os.remove(commandPath)
      return
    end
    append(string.format("DIRECT COMPLETED tag=%s normalized=0x%08X before=%d after=%d address=0x%X",
      command.tag,command.normalized,before,after,quantityPointer))
    state("completed",string.format("tag=%s direct before=%d after=%d",command.tag,before,after))
    os.remove(commandPath)
    return
  end
  if command.normalized==bootstrapVialNormalized then
    state("failed",string.format("tag=%s absent Blood Vial insertion is disabled after live invalid-record reproduction; acquire one Vial before delivery",command.tag))
    os.remove(commandPath)
    return
  end
  if readInteger(request)~=0 then state("busy","Native request already pending") return end
  writeInteger(descriptor+0,command.raw); writeInteger(descriptor+4,0)
  writeQword(descriptor+8,0); writeInteger(descriptor+0x10,command.normalized)
  writeInteger(descriptor+0x14,0)
  writeInteger(slotIndex,slot or 0xFFFFFFFF)
  writeQword(itemQuantityPointer,quantityPointer or 0)
  writeInteger(manualTrigger,command.manualTrigger and 1 or 0)
  writeInteger(quantity,command.count); writeInteger(result,0xFFFFFFFF); writeInteger(done,0)
  state("executing",string.format("tag=%s expected_before=%d expected_after=%d",command.tag,command.expected,wanted))
  writeInteger(request,1); active=command
  append(string.format("AUTO QUEUED tag=%s raw=0x%08X normalized=0x%08X quantity=%d expected_before=%d",command.tag,command.raw,command.normalized,command.count,command.expected))
  state("queued",string.format("tag=%s trigger=%s",command.tag,command.manualTrigger and "manual_consumable" or "automatic_heartbeat"))
end

if bbNativeGrantHarnessTimer then bbNativeGrantHarnessTimer.destroy() end
bbNativeGrantHarnessTimer=createTimer(nil); bbNativeGrantHarnessTimer.Interval=250
bbNativeGrantHarnessTimer.OnTimer=poll; bbNativeGrantHarnessTimer.Enabled=true
bbNativeGrantHarnessPid=pid
local pendingCommand=io.open(commandPath,"r")
if pendingCommand then pendingCommand:close() end
if pendingCommand and prior.build==build and prior.protocol==protocol and prior.harness==harness and prior.tag~="" then
  state("recovery_pending","Retained command and durable expected counts will be reconciled")
else
  stateTag=""; stateExpectedBefore=""; stateExpectedAfter=""
  state("awaiting_inventory","Use one bullet once after launch")
end
append(string.format("AUTO V5 READY build=%s protocol=%s harness=%s pid=%d ebootBase=0x%X consumeHook=0x%X heartbeatHook=0x%X",build,protocol,harness,pid,base,consumeHook,heartbeatHook))
if pendingCommand and prior.build==build and prior.protocol==protocol and prior.harness==harness and prior.tag~="" then
  showMessage("Bloodborne AP table setup SUCCESS.\nA retained command is awaiting reconciliation; follow the client recovery instructions.")
else
  showMessage("Bloodborne AP table setup SUCCESS.\nThe grant harness is installed. If no bootstrap result appears, fire one Bullet.")
end
end

-- Self-attach with retry: the launcher spawns CE alongside shadPS4, so the
-- table must not require a manual attach first. Attach as soon as shadPS4.exe
-- exists, then retry harness start once a second while the failure is the
-- not-booted-yet race ("Logged eboot base ..."); anything else is terminal.
local bbMaxStartAttempts=240
if bbNativeGrantStartTimer then bbNativeGrantStartTimer.destroy() end
bbNativeGrantStartTimer=createTimer(nil); bbNativeGrantStartTimer.Interval=1000
bbNativeGrantStartAttempts=0
bbNativeGrantStartTimer.OnTimer=function(t)
  bbNativeGrantStartAttempts=bbNativeGrantStartAttempts+1
  local attachedPid=getOpenedProcessID()
  if attachedPid and attachedPid~=0 then
    local started,startError=pcall(startBloodborneHarness)
    if started then t.Enabled=false; return end
    if not tostring(startError):find("Logged eboot base") then
      t.Enabled=false
      showMessage("Bloodborne AP table setup failed:\n"..tostring(startError))
      return
    end
  else
    local targetPid=getProcessIDFromName("shadPS4.exe")
    if targetPid then openProcess(targetPid) end
  end
  if bbNativeGrantStartAttempts>=bbMaxStartAttempts then
    t.Enabled=false
    showMessage("Bloodborne AP table: shadPS4 did not become ready within 4 minutes; attach to shadPS4.exe manually and reload the table.")
  end
end
bbNativeGrantStartTimer.Enabled=true
]]></LuaScript>
</CheatTable>
