<?xml version="1.0" encoding="utf-8"?>
<!-- Reads the installed grant harness data only; performs no writes. -->
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries/>
  <UserdefinedSymbols/>
  <LuaScript><![CDATA[
local shadLog=[[C:\Users\alari\AppData\Roaming\shadPS4\log\shad_log.txt]]
local output=[[C:\Users\alari\bb-archipelago\work\shad-0.18-grant-status.txt]]
local f=assert(io.open(shadLog,"r"))
local pending,base=false,nil
for line in f:lines() do
  if line:find("Loading module eboot.bin",1,true) then pending=true
  elseif pending then
    local hex=line:match("base_virtual_addr%s+%.+:%s+0x([0-9A-Fa-f]+)")
    if hex then base=tonumber(hex,16); pending=false end
  end
end
f:close()
if not base then error("Could not resolve eboot base") end
openProcess("shadPS4.exe")
local data=base+0x50DBE00
local lines={
  string.format("pid=%d",getOpenedProcessID()),
  string.format("eboot_base=0x%X",base),
  string.format("request=%s",tostring(readInteger(data+0))),
  string.format("quantity=%s",tostring(readInteger(data+4))),
  string.format("native_result_signed=%s",tostring(readInteger(data+8))),
  string.format("native_result_hex=0x%08X",readInteger(data+8) or 0),
  string.format("done=%s",tostring(readInteger(data+0xC))),
  string.format("inventory_pointer=0x%X",readQword(data+0x10) or 0),
  string.format("descriptor_raw=0x%08X",readInteger(data+0x20) or 0),
  string.format("descriptor_normalized=0x%08X",readInteger(data+0x24) or 0),
}
local out=assert(io.open(output,"w")); out:write(table.concat(lines,"\n").."\n"); out:close()
showMessage("Read-only grant status captured")
]]></LuaScript>
</CheatTable>
